#!/bin/sh
# Copyright (c) 2026 AWA <https://www.akkdiy.cn>. All rights reserved.
# 安装后：把套件服务账号加入 administrators 组，并授予「以 root 运行调度进程」的最小权限。
# 文件同步必须能遍历用户数据（含 /volume1/homes），这是本套件能工作的前提。
set -u

PKG_USER="filesync"
PKG_BASE="/var/packages/FileSync"
mkdir -p "${PKG_BASE}/var" 2>/dev/null || true
echo "$(date '+%F %T') [postinst] uid=$(id -u) user=$(id -un 2>/dev/null)" >> "${PKG_BASE}/var/install.log" 2>/dev/null || true
ROOTLAUNCH="${PKG_BASE}/target/share/run_worker.sh"
STOPLAUNCH="${PKG_BASE}/target/share/stop_worker.sh"
SUDO_FILE="/etc/sudoers.d/FileSync-worker"
SUDO_RULE="${PKG_USER} ALL=(root) NOPASSWD: ${ROOTLAUNCH}, ${STOPLAUNCH}"
MARK_BEGIN="# >>> FileSync worker >>>"
MARK_END="# <<< FileSync worker <<<"

if id "$PKG_USER" >/dev/null 2>&1; then
    synogroup --memberadd administrators "$PKG_USER" >/dev/null 2>&1 || true
fi

# 预建运行目录，保证权限正确
mkdir -p "${PKG_BASE}/var"
chmod 0700 "${PKG_BASE}/var"
if id "$PKG_USER" >/dev/null 2>&1; then
    chown "$PKG_USER:$PKG_USER" "${PKG_BASE}/var" 2>/dev/null || true
fi

# --------------------------------------------------------------------------
# 让调度进程以 root 运行（这是修好「没有权限访问 /volume1/homes」的关键）。
#
# DSM 7 出于安全，禁止第三方（未签名）套件在 spk 的 privilege 里声明
# run-as: root，否则安装直接被拒。但运行时 DSM 读的是「已安装」的 privilege
# 文件，所以社区成熟做法（Jellyfin / Zerotier 等）就是装完后把它改成 root，
# 重启套件即生效。改完之后 start-stop-status 以 root 被拉起，worker 也就是
# root，自然能读 /volume1/homes、别人的共享文件夹、加密目录。
#
# 只改 run-as 这一处；CGI 仍由下面 tool 段保持为套件账号 filesync，靠 worker
# 开的本地 socket 代读目录，职责分离、最小权限。
# --------------------------------------------------------------------------
PRIV_FILE="${PKG_BASE}/conf/privilege"
if [ -f "$PRIV_FILE" ]; then
    if grep -Eq '"run-as"[[:space:]]*:[[:space:]]*"package"' "$PRIV_FILE"; then
        sed -i 's/"run-as"[[:space:]]*:[[:space:]]*"package"/"run-as": "root"/' "$PRIV_FILE" 2>/dev/null || true
        {
            echo "$(date '+%F %T') 已将 ${PRIV_FILE} 的 run-as 改为 root；重启套件后调度进程即以 root 运行。"
        } >> "${PKG_BASE}/var/install.log" 2>/dev/null || true
    fi
    sync "$PRIV_FILE" 2>/dev/null || true
    echo "$(date '+%F %T') [postinst] privilege run-as:" >> "${PKG_BASE}/var/install.log" 2>/dev/null || true
    grep -m1 'run-as' "$PRIV_FILE" >> "${PKG_BASE}/var/install.log" 2>/dev/null || true
fi

# --------------------------------------------------------------------------
# 免密 sudo（兜底）：只允许套件账号执行 run_worker.sh，且脚本不接受任何参数。
# 正常情况下上面的 run-as:root 已让 worker 是 root，这里只是极端情况下的退路。
# --------------------------------------------------------------------------
if [ -x "$ROOTLAUNCH" ]; then
    mkdir -p /etc/sudoers.d
    chmod 0755 /etc/sudoers.d 2>/dev/null || true
    printf '%s\n' "$SUDO_RULE" > "$SUDO_FILE" 2>/dev/null || true
    chown root:root "$SUDO_FILE" 2>/dev/null || true
    chmod 0440 "$SUDO_FILE" 2>/dev/null || true

    # 规则写坏了会让 sudo 整体失效，先单独校验一次
    if command -v visudo >/dev/null 2>&1; then
        visudo -cf "$SUDO_FILE" >/dev/null 2>&1 || rm -f "$SUDO_FILE"
    fi

    # sudoers.d 不一定被 include，确认规则真的生效；不生效就直接写进主文件
    if ! sudo -n -l -U "$PKG_USER" 2>/dev/null | grep -Fq "run_worker.sh"; then
        if [ -f /etc/sudoers ] && ! grep -Fq "$MARK_BEGIN" /etc/sudoers; then
            cp -a /etc/sudoers /etc/sudoers.filesync.bak 2>/dev/null || true
            {
                printf '\n%s\n' "$MARK_BEGIN"
                printf '%s\n' "$SUDO_RULE"
                printf '%s\n' "$MARK_END"
            } >> /etc/sudoers 2>/dev/null || true
            if command -v visudo >/dev/null 2>&1; then
                if ! visudo -c >/dev/null 2>&1; then
                    # 校验不过就还原：宁可没有 root，也不能把 sudo 弄坏
                    [ -f /etc/sudoers.filesync.bak ] && cp -a /etc/sudoers.filesync.bak /etc/sudoers
                fi
            fi
        fi
    fi
fi

exit 0
